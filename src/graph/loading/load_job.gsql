// ============================================================================
// TigerGraph GSQL Loading Job for FraudNet
// ============================================================================

USE GRAPH FraudNet;

CREATE LOADING JOB load_fraudnet FOR GRAPH FraudNet {
    DEFINE FILENAME txns_file;
    DEFINE FILENAME identity_file;
    DEFINE FILENAME closed_file;

    // Load Identity & Devices
    LOAD identity_file TO VERTEX DeviceProfile VALUES(
        gsql_concat($DeviceInfo, " | ", $id_30, " | ", $id_31, " | ", $id_33),
        $DeviceInfo, $id_30, $id_31, $id_33, $DeviceType, $id_23
    ) WHERE $DeviceInfo IS NOT NULL OR $id_30 IS NOT NULL;

    // Load Transactions & Direct Attributes
    LOAD txns_file TO VERTEX Customer VALUES($customer_id) WHERE $customer_id IS NOT NULL;

    LOAD txns_file TO VERTEX Card VALUES(
        gsql_concat($customer_id, "-K1"),
        $customer_id, $card1, $card2, $card3, $card4, $card5, $card6
    ) WHERE $customer_id IS NOT NULL;

    LOAD txns_file TO VERTEX Transaction VALUES(
        $TransactionID, $ts, $TransactionAmt, $ProductCD, $channel, $risk_score,
        $dist1, $dist2, $P_emaildomain, $R_emaildomain
    );

    LOAD txns_file TO VERTEX EmailDomain VALUES($P_emaildomain) WHERE $P_emaildomain IS NOT NULL;
    LOAD txns_file TO VERTEX BillingRegion VALUES($addr1, $addr2) WHERE $addr1 IS NOT NULL;

    // Load Edges
    LOAD txns_file TO EDGE OWNS VALUES($customer_id, gsql_concat($customer_id, "-K1")) WHERE $customer_id IS NOT NULL;
    LOAD txns_file TO EDGE MADE VALUES(gsql_concat($customer_id, "-K1"), $TransactionID);
    LOAD txns_file TO EDGE PURCHASER_EMAIL VALUES($TransactionID, $P_emaildomain) WHERE $P_emaildomain IS NOT NULL;
    LOAD txns_file TO EDGE BILLED_IN VALUES($TransactionID, $addr1) WHERE $addr1 IS NOT NULL;

    LOAD identity_file TO EDGE FROM_DEVICE VALUES(
        $TransactionID,
        gsql_concat($DeviceInfo, " | ", $id_30, " | ", $id_31, " | ", $id_33)
    ) WHERE $DeviceInfo IS NOT NULL OR $id_30 IS NOT NULL;

    // Load Closed Cases
    LOAD closed_file TO VERTEX ClosedCase VALUES(
        $case_id, $opened_at, $closed_at, $outcome, $pattern,
        $first_fraud_txn_id, $n_txns, $exposure_usd, $actions_taken,
        $report_filed, $analyst_notes
    );

    LOAD closed_file TO EDGE ON_CARD VALUES($case_id, $card_id) WHERE $card_id IS NOT NULL;
    LOAD closed_file TO EDGE INVOLVES VALUES($case_id, SPLIT($txn_ids, "|")) WHERE $txn_ids IS NOT NULL;
    LOAD closed_file TO EDGE CONNECTED_TO VALUES($case_id, SPLIT($connected_card_ids, "|")) WHERE $connected_card_ids IS NOT NULL;
}
