# FraudNet Environment Configuration
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to git.

# ── TigerGraph Cloud ──────────────────────────────────────────────────────────
TG_HOST=https://your-instance.i.tgcloud.io
TG_GRAPH_NAME=FraudNet
TG_GRAPHNAME=FraudNet
TG_SECRET=your-tigergraph-secret-here
TG_TGCLOUD=true

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Benchmark was run with Groq via the OpenAI-compatible API.
# Set OPENAI_API_KEY to your Groq API key and OPENAI_BASE_URL to the Groq endpoint.
OPENAI_API_KEY=your-groq-or-openai-api-key-here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-20b

# ── Optional: Google Gemini ────────────────────────────────────────────────
# GEMINI_API_KEY=your-gemini-api-key-here

# ── Optional: Mistral ────────────────────────────────────────────────────────
# MISTRAL_API_KEY=your-mistral-api-key-here

# ── Backend ───────────────────────────────────────────────────────────────────
# auto = try TigerGraph first, fall back to in-memory CSV store
# tigergraph = strict TigerGraph only (raises error if unreachable)
# in_memory = always use local CSV dataset (no TigerGraph required)
TG_BACKEND=auto
